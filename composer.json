{
    "name": "yananob/line-sender",
    "description": "yananob/line-sender",
    "license": "proprietary",
    "require": {
        "php": ">= 8.2",
        "google/cloud-functions-framework": "^1.3",
        "google/protobuf": "^5.35",
        "smarty/smarty": "^4.3",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.3",
        "phpstan/phpstan": "^1.10"
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "FUNCTION_TARGET=main php -S localhost:${PORT:-8080} vendor/google/cloud-functions-framework/router.php"
        ]
    },
    "autoload": {
        "psr-4": {
            "MyApp\\": "./src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyApp\\Tests\\": "./tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
